<Window x:Class="SafeGitPublisher.Views.ReportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:SafeGitPublisher.Converters"
        Icon="pack://application:,,,/SafeGitPublisher;component/Assets/SafeGitPublisher.ico"
        Title="发布前检查详细报告" Width="900" Height="650" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterOwner" Background="{StaticResource PageBg}">
    <Window.Resources>
        <conv:SeverityToColorConverter x:Key="SevToColor" />
        <conv:CountToVisibilityConverter x:Key="CountToVis" />
        <conv:CountToVisibilityConverter x:Key="EmptyVis" Invert="True" />
        <conv:CountGreaterThanConverter x:Key="MoreThan50Vis" Threshold="50" />
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{StaticResource SectionTitle}" Text="发布前检查详细报告" />

        <TabControl Grid.Row="1" Margin="0,8,0,0">
            <!-- ===== 检查结果 ===== -->
            <TabItem Header="检查结果">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
                    <ItemsControl ItemsSource="{Binding Context.Report.Checks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Margin="0,4">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Status, Converter={StaticResource StatusToGlyph}}"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       Foreground="{Binding Status, Converter={StaticResource StatusToColor}}"
                                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <Border Background="#F0F2F5" CornerRadius="3" Padding="6,1" Margin="8,0,0,0"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding StatusText}" FontSize="11"
                                                           Foreground="{Binding Status, Converter={StaticResource StatusToColor}}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Summary}" Margin="22,6,0,0" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Details}" Margin="22,4,0,0" TextWrapping="Wrap"
                                                   Foreground="{StaticResource TextSecondary}" FontSize="12" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </TabItem>

            <!-- ===== Secret 扫描 ===== -->
            <TabItem Header="Secret 扫描">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
                    <StackPanel>
                        <Border Padding="12,18" Background="#F8FAFC" CornerRadius="4"
                                Visibility="{Binding Context.SecretFindings.Count, Converter={StaticResource EmptyVis}}">
                            <TextBlock Text="✓ 未发现 Secret 风险" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource PassBrush}" HorizontalAlignment="Center" />
                        </Border>
                        <ItemsControl ItemsSource="{Binding Context.SecretFindings}"
                                      Visibility="{Binding Context.SecretFindings.Count, Converter={StaticResource CountToVis}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" Margin="0,4">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding SeverityDisplay}" FontWeight="SemiBold"
                                                           Foreground="{Binding Severity, Converter={StaticResource SevToColor}}"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding File}" Margin="8,0,0,0" FontWeight="SemiBold"
                                                           VerticalAlignment="Center" ToolTip="{Binding File}" />
                                                <TextBlock Text="{Binding Line, Mode=OneWay, StringFormat={}  行 {0}}" Margin="8,0,0,0"
                                                           FontSize="12" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Message}" Margin="0,6,0,0" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Preview}" Margin="0,4,0,0" FontFamily="Consolas"
                                                       Foreground="{StaticResource TextSecondary}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===== 变更文件 ===== -->
            <TabItem Header="变更文件">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
                    <StackPanel>
                        <Border Padding="12,18" Background="#F8FAFC" CornerRadius="4"
                                Visibility="{Binding Context.Changes.Count, Converter={StaticResource EmptyVis}}">
                            <TextBlock Text="✓ 工作区干净" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource PassBrush}" HorizontalAlignment="Center" />
                        </Border>
                        <ItemsControl ItemsSource="{Binding Context.Changes}"
                                      Visibility="{Binding Context.Changes.Count, Converter={StaticResource CountToVis}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="90" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding StatusLabel}" Foreground="{StaticResource TextSecondary}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Path}" FontFamily="Consolas"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                                        <TextBlock Grid.Column="2" Text="{Binding SizeDisplay}" HorizontalAlignment="Right"
                                                   Foreground="{StaticResource TextSecondary}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===== 已安全忽略 ===== -->
            <TabItem Header="已安全忽略">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
                    <StackPanel>
                        <TextBlock Text="以下危险文件存在于磁盘，但已被 .gitignore 正确排除，不会进入提交。"
                                   Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,8" />
                        <Border Padding="12,18" Background="#F8FAFC" CornerRadius="4"
                                Visibility="{Binding Context.IgnoredSafePaths.Count, Converter={StaticResource EmptyVis}}">
                            <TextBlock Text="没有发现需要特别说明的已忽略危险文件" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{Binding Context.IgnoredSafePathTotal, StringFormat={}已安全忽略 {0} 个（.gitignore 已排除）}"
                                   Foreground="{StaticResource PassBrush}" Margin="0,0,0,8"
                                   Visibility="{Binding Context.IgnoredSafePaths.Count, Converter={StaticResource CountToVis}}" />
                        <TextBlock Text="仅展示前 50 个，其余为已忽略的编译/生成输出。"
                                   Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,0,0,6"
                                   Visibility="{Binding Context.IgnoredSafePathTotal, Converter={StaticResource MoreThan50Vis}}" />
                        <ItemsControl ItemsSource="{Binding Context.IgnoredSafePathsDisplay}"
                                      Visibility="{Binding Context.IgnoredSafePaths.Count, Converter={StaticResource CountToVis}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="12" Margin="0,2"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="关闭" Style="{StaticResource SecondaryButton}" Width="100" Click="OnClose" />
        </StackPanel>
    </Grid>
</Window>
