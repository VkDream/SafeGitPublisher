<Window x:Class="SafeGitPublisher.Views.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="pack://application:,,,/SafeGitPublisher;component/Assets/SafeGitPublisher.ico"
        Title="关于 SafeGitPublisher" Width="500" Height="420" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{StaticResource PageBg}">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <Image Width="48" Height="48" VerticalAlignment="Center"
                   Source="{Binding Icon, RelativeSource={RelativeSource AncestorType=Window}}"
                   RenderOptions.BitmapScalingMode="HighQuality" />
            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="SafeGitPublisher" FontSize="20" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimary}" />
                <TextBlock Text="GitHub 安全发布助手" FontSize="12"
                           Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0" />
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,18,0,0" Padding="14">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,2">
                    <TextBlock Text="版本" Foreground="{StaticResource TextSecondary}" Width="90" />
                    <TextBlock x:Name="VersionText" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,6">
                    <TextBlock Text="技术" Foreground="{StaticResource TextSecondary}" Width="90" />
                    <TextBlock Text=".NET 10 / WPF / MVVM" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,6">
                    <TextBlock Text="作者" Foreground="{StaticResource TextSecondary}" Width="90" />
                    <TextBlock Text="VkDream" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,6">
                    <TextBlock Text="Repository" Foreground="{StaticResource TextSecondary}" Width="90" />
                    <TextBlock Text="GitHub Repository 尚未发布" Foreground="{StaticResource TextSecondary}" />
                </StackPanel>

                <TextBlock Text="用于在提交前检查：" FontWeight="SemiBold" Margin="0,16,0,6" />
                <TextBlock Text="· Git 状态 / 敏感文件 / Secret / .gitignore" FontSize="12" Margin="0,2" />
                <TextBlock Text="· Git 作者身份 / Remote / 分支 / 大文件" FontSize="12" Margin="0,2" />
                <TextBlock Text="· 图片隐私人工确认 / dotnet Build" FontSize="12" Margin="0,2" />
                <TextBlock Text="· 安全提交与上传（绝不自动执行危险命令）" FontSize="12" Margin="0,2" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="关闭" Style="{StaticResource SecondaryButton}" Width="100" Click="OnClose" />
        </StackPanel>
    </Grid>
</Window>
