<Window x:Class="SafeGitPublisher.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:SafeGitPublisher.Converters"
        Icon="pack://application:,,,/SafeGitPublisher;component/Assets/SafeGitPublisher.ico"
        Title="SafeGitPublisher — GitHub 安全发布助手"
        Width="1280" Height="820" MinWidth="1100" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBg}">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BusyVis" />
        <conv:BoolToVisibilityConverter x:Key="ImgVis" />
        <conv:BoolToVisibilityConverter x:Key="BannerVis" />
        <conv:CommitPrefixToChineseConverter x:Key="CommitPrefixToChinese" />

        <!-- 仓库摘要 Chip 样式 -->
        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="Background" Value="#EEF3FA" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="ChipLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
        </Style>
        <Style x:Key="ChipValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,1,0,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="MaxWidth" Value="260" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- ==================== 顶部 Header ==================== -->
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource CardBorder}"
                BorderThickness="0,0,0,1" Padding="16,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Image Width="30" Height="30" VerticalAlignment="Center"
                           Source="{Binding Icon, RelativeSource={RelativeSource AncestorType=Window}}"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="SafeGitPublisher" FontSize="17" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimary}" />
                        <TextBlock Text="GitHub 安全发布助手" FontSize="11"
                                   Foreground="{StaticResource TextSecondary}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#E3F0FC" CornerRadius="4" Padding="7,2" Margin="0,0,14,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding AppVersionText}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentBrush}" />
                    </Border>
                    <TextBlock Text="{Binding GitVersionText}" Foreground="{StaticResource TextSecondary}"
                               VerticalAlignment="Center" Margin="0,0,14,0" />
                    <TextBlock Text="{Binding DotNetVersionText}" Foreground="{StaticResource TextSecondary}"
                               VerticalAlignment="Center" Margin="0,0,14,0" />
                    <Button Content="设置" Style="{StaticResource SecondaryButton}" Height="28" Padding="10,2"
                            Command="{Binding ShowSettingsCommand}" />
                    <Button Content="关于" Style="{StaticResource SecondaryButton}" Height="28" Padding="10,2"
                            Margin="8,0,0,0" Click="OnAbout" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ==================== 主内容 ==================== -->
        <Grid Margin="16,14,16,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />   <!-- 项目栏 -->
                <RowDefinition Height="Auto" />   <!-- 仓库摘要 chips -->
                <RowDefinition Height="Auto" />   <!-- 发布状态 Banner -->
                <RowDefinition Height="Auto" />   <!-- 忙碌条 -->
                <RowDefinition Height="Auto" />   <!-- 图片确认 -->
                <RowDefinition Height="Auto" />   <!-- 检查标题 + 按钮 -->
                <RowDefinition Height="*" MinHeight="150" />   <!-- 检查项 + 变更 -->
                <RowDefinition Height="Auto" />   <!-- 提交说明区 -->
                <RowDefinition Height="1.0*" MinHeight="100" /> <!-- 日志 -->
            </Grid.RowDefinitions>

            <!-- ===== 项目选择 ===== -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="项目目录" VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondary}" Width="70" />
                <TextBox Grid.Column="1" Text="{Binding ProjectPath, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="{Binding ProjectPath}" />
                <Button Grid.Column="2" Content="选择…" Style="{StaticResource SecondaryButton}"
                        Width="80" Margin="8,0,8,0" Command="{Binding BrowseProjectCommand}" />
                <ComboBox Grid.Column="3" Width="260"
                          ItemsSource="{Binding RecentProjects}"
                          SelectedItem="{Binding SelectedRecentProject, Mode=TwoWay}"
                          ToolTip="最近项目（点击选择后自动检查）" />
            </Grid>

            <!-- ===== 仓库摘要 chips ===== -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0"
                        Visibility="{Binding IsGitRepo, Converter={StaticResource BannerVis}}">
                <Border Style="{StaticResource Chip}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource ChipLabel}" Text="仓库" />
                        <TextBlock Style="{StaticResource ChipValue}" Text="{Binding RepoNameText}" ToolTip="{Binding RepoNameText}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Chip}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource ChipLabel}" Text="分支" />
                        <TextBlock Style="{StaticResource ChipValue}" Text="{Binding BranchText}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Chip}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource ChipLabel}" Text="Remote" />
                        <TextBlock Style="{StaticResource ChipValue}" Text="{Binding RemoteSummaryText}" ToolTip="{Binding RemoteSummaryText}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Chip}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource ChipLabel}" Text="身份" />
                        <TextBlock Style="{StaticResource ChipValue}" Text="{Binding IdentitySummaryText}" ToolTip="{Binding IdentitySummaryText}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Chip}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource ChipLabel}" Text="状态" />
                        <TextBlock Style="{StaticResource ChipValue}" Text="{Binding WorktreeSummaryText}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ===== 发布状态 Banner ===== -->
            <Border Grid.Row="2" Margin="0,10,0,0" CornerRadius="4" Padding="12,8"
                    Visibility="{Binding PublishBannerVisible, Converter={StaticResource BannerVis}}"
                    Background="{Binding PublishBannerBrush}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding PublishBannerGlyph}" FontFamily="Segoe MDL2 Assets"
                               Foreground="White" FontSize="15" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding PublishBannerTitle}" Foreground="White" FontWeight="Bold"
                               FontSize="14" VerticalAlignment="Center" Margin="8,0,0,0" />
                    <TextBlock Text="{Binding PublishBannerDetail}" Foreground="White" FontSize="13"
                               VerticalAlignment="Center" Margin="10,0,0,0" />
                </StackPanel>
            </Border>

            <!-- ===== 忙碌条 ===== -->
            <Border Grid.Row="3" Margin="0,8,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BusyVis}}"
                    Background="#E3F2FC" CornerRadius="4" Padding="10,6">
                <DockPanel>
                    <ProgressBar DockPanel.Dock="Left" Width="180" Height="6" IsIndeterminate="True" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding BusyText}" Margin="12,0,0,0" VerticalAlignment="Center"
                               Foreground="{StaticResource AccentBrush}" />
                    <Button DockPanel.Dock="Right" Content="取消" Style="{StaticResource SecondaryButton}"
                            Height="26" Command="{Binding CancelCommand}" />
                </DockPanel>
            </Border>

            <!-- ===== 图片确认 ===== -->
            <Border Grid.Row="4" Style="{StaticResource Card}" Margin="0,8,0,0"
                    Visibility="{Binding ImageConfirmationRequired, Converter={StaticResource ImgVis}}">
                <CheckBox IsChecked="{Binding ImageConfirmed, UpdateSourceTrigger=PropertyChanged}"
                          Foreground="{StaticResource WarningBrush}"
                          Content="我确认本次新增的图片已完成脱敏检查（不存在客户名称、内部项目名、用户名、邮箱、服务器地址等敏感信息）。" />
            </Border>

            <!-- ===== 检查标题 + 按钮 ===== -->
            <Grid Grid.Row="5" Margin="0,10,0,6">
                <TextBlock VerticalAlignment="Center">
                    <Run Text="发布前检查" FontWeight="SemiBold" FontSize="15" />
                    <Run Text="{Binding ChecksCount, Mode=OneWay, StringFormat={}（{0} 项）}" Foreground="{StaticResource TextSecondary}" FontSize="12" />
                </TextBlock>
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button Content="重新检查" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                            Command="{Binding RunChecksCommand}" />
                    <Button Content="同步远端" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                            Command="{Binding SyncRemoteCommand}" />
                    <Button Content="查看详细报告" Style="{StaticResource SecondaryButton}"
                            Command="{Binding ShowReportCommand}" />
                </StackPanel>
            </Grid>

            <!-- ===== 检查区 + 变更列表 ===== -->
            <Grid Grid.Row="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="300" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="1.4*" MinWidth="360" />
                </Grid.ColumnDefinitions>

                <!-- 左侧：检查项 -->
                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Checks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="26" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Status, Converter={StaticResource StatusToGlyph}}"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   Foreground="{Binding Status, Converter={StaticResource StatusToColor}}"
                                                   VerticalAlignment="Top" Margin="0,1,0,0" />
                                        <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                <Border Background="#F0F2F5" CornerRadius="3" Padding="5,1" Margin="8,0,0,0">
                                                    <TextBlock Text="{Binding StatusText}" FontSize="11"
                                                               Foreground="{Binding Status, Converter={StaticResource StatusToColor}}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Summary}" Foreground="{StaticResource TextSecondary}"
                                                       FontSize="12" TextWrapping="Wrap" ToolTip="{Binding Details}" />
                                        </StackPanel>
                                        <Button Grid.Column="2" Content="{Binding FixLabel}" Style="{StaticResource SecondaryButton}"
                                                Margin="8,0,0,0" Height="26" Padding="8,2" VerticalAlignment="Top"
                                                Visibility="{Binding FixLabel, Converter={StaticResource StringToVis}}"
                                                Command="{Binding DataContext.FixCheckCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding Id}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <!-- 右侧：变更列表 -->
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionTitle}">本次变更</TextBlock>

                        <!-- 空状态 -->
                        <Border DockPanel.Dock="Top" Padding="12,18" Background="#F8FAFC" CornerRadius="4"
                                Visibility="{Binding HasCommittableChanges, Converter={StaticResource InverseBoolToVis}}">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="✓ 工作区干净" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{StaticResource PassBrush}" HorizontalAlignment="Center" />
                                <TextBlock Text="当前没有需要提交的文件" FontSize="12"
                                           Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <ListView x:Name="ChangesList" ItemsSource="{Binding Changes}"
                                  Visibility="{Binding HasCommittableChanges, Converter={StaticResource BannerVis}}"
                                  BorderThickness="0">
                            <ListView.Resources>
                                <ContextMenu x:Key="ChangeItemMenu">
                                    <MenuItem Header="复制文件路径" Click="OnCopyPath" />
                                    <MenuItem Header="在资源管理器中定位" Click="OnRevealInExplorer" />
                                </ContextMenu>
                            </ListView.Resources>
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="ContextMenu" Value="{StaticResource ChangeItemMenu}" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="状态" Width="62">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding StatusLabel}" Foreground="{StaticResource TextSecondary}" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="文件" Width="300">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock>
                                                    <Run Text="{Binding Path, Mode=OneWay}" FontFamily="Consolas"
                                                         ToolTip="{Binding Path}" />
                                                    <Run Text="{Binding OldPath, Mode=OneWay, StringFormat={}  ← {0}}" Foreground="{StaticResource TextSecondary}" />
                                                </TextBlock>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="大小" Width="76">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding SizeDisplay}" HorizontalAlignment="Right"
                                                           Foreground="{StaticResource TextSecondary}" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="风险" Width="90">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="#F0F2F5" CornerRadius="3" Padding="6,1" HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding Risk, Converter={StaticResource RiskToText}}"
                                                               FontSize="11"
                                                               Foreground="{Binding Risk, Converter={StaticResource RiskToColor}}" />
                                                </Border>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- ===== 提交说明区 ===== -->
            <Border Grid.Row="7" Style="{StaticResource Card}" Margin="0,10,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,14,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="提交说明" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,12,0" />
                            <ComboBox Width="150" ItemsSource="{Binding CommitPrefixes}"
                                      SelectedItem="{Binding SelectedCommitPrefix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      ToolTip="选择提交类型，最终提交仍使用标准前缀">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource CommitPrefixToChinese}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <TextBox Margin="0,6,0,0" Text="{Binding CommitMessage, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="{Binding CommitMessage}" />
                        <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="{StaticResource TextSecondary}">
                            <Run Text="最终提交：" />
                            <Run Text="{Binding CommitMessage, Mode=OneWay}" FontFamily="Consolas" />
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <Button Content="仅提交" Style="{StaticResource SecondaryButton}" Width="130" Height="34"
                                Margin="0,0,10,8" Command="{Binding CommitOnlyCommand}"
                                IsEnabled="{Binding CanCommit}" ToolTip="{Binding CommitTooltip}" />
                        <Button Content="安全提交并上传" Style="{StaticResource PrimaryButton}" Width="160" Height="34"
                                Command="{Binding SafeCommitAndPushCommand}"
                                IsEnabled="{Binding CanPush}" ToolTip="{Binding PushTooltip}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===== 日志 ===== -->
            <Border Grid.Row="8" Style="{StaticResource Card}" Margin="0,10,0,0">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                        <TextBlock Style="{StaticResource SectionTitle}" Text="日志" VerticalAlignment="Center" />
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                            <Button Content="复制日志" Style="{StaticResource SecondaryButton}" Height="24" Padding="8,0"
                                    Margin="0,0,8,0" Click="OnCopyLogs" />
                            <Button Content="清空日志" Style="{StaticResource SecondaryButton}" Height="24" Padding="8,0"
                                    Click="OnClearLogs" />
                        </StackPanel>
                    </Grid>
                    <ListBox x:Name="LogList" ItemsSource="{Binding Logs}"
                             Background="#FCFCFC" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding DisplayTime}" Foreground="{StaticResource TextSecondary}" FontFamily="Consolas" />
                                    <TextBlock Text="{Binding LevelShort}" Margin="8,0,6,0" FontWeight="SemiBold" FontFamily="Consolas"
                                               Foreground="{Binding Level, Converter={StaticResource LogLevelToColor}}" />
                                    <TextBlock Text="{Binding Message}" Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ==================== 底部状态栏 ==================== -->
        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="{StaticResource CardBorder}"
                BorderThickness="0,1,0,0" Padding="16,6">
            <TextBlock Text="{Binding StatusBarText}" Foreground="{StaticResource TextSecondary}" FontSize="12" />
        </Border>
    </DockPanel>
</Window>
