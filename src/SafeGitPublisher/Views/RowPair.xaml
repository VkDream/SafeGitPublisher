<UserControl x:Class="SafeGitPublisher.Views.RowPair"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="26">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="{Binding Label, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="{Binding Value, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   TextWrapping="Wrap" VerticalAlignment="Center" FontWeight="SemiBold" />
    </Grid>
</UserControl>