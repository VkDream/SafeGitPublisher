<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SafeGitPublisher</RootNamespace>
    <AssemblyName>SafeGitPublisher</AssemblyName>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\SafeGitPublisher.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>1.0.0</InformationalVersion>
    <Product>SafeGitPublisher</Product>
    <Description>GitHub 安全发布助手</Description>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="..\..\assets\SafeGitPublisher.ico">
      <Link>Assets\SafeGitPublisher.ico</Link>
    </Resource>
  </ItemGroup>

</Project>